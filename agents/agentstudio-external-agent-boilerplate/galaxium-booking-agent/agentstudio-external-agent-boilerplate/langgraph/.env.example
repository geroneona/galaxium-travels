ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:3000,http://localhost:80"

ICA_ENDPOINT="https://servicesessentials.ibm.com/agenticapps/api/v1"
ICA_TEAM_ID="699331731e26f97e0123a85d"
ICA_TOKEN="<your-jwt-or-api-token>"
ICA_APP_ID="f16c63ed-21c5-4e21-9b4f-fa0053e461d4"

# ICA_USER_ID="699337b91b25031459b755b6"  # optional, assigns ownership of registered agents to this user
ICA_REGISTER_AGENT=false  # trun automatic agent degistration on or off
ICA_OBSERVABILITY=false  # turn observability with Phoenix on or off
# PHOENIX_COLLECTOR_ENDPOINT="https://pheonix-ica-agenticapps.ica-np-us-south-dev-83f075ec965da16d61cd1225fb6731fe-0000.us-south.containers.appdomain.cloud/v1/traces"
AGENTSTUDIO_HOOKS=hooks_example

WA_MCP_SERVER_URL=https://example.example.example/servers/ecd73be553f14aa9988fd4c1c28b14a2/mcp 
# WA_AUTHORIZATION="Bearer eyJh..."

# Rulebook AI MCP Server Configuration, optional
RULEBOOK_MCP_SERVER_URL=https://ica-pr-us-south-global-83f075ec965da16d61cd1225fb6731fe-0007.us-south.containers.appdomain.cloud/servers/675f35f6cc2d4465aae5e6b92e7cc3f4/mcp
