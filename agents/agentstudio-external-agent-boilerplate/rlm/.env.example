# allowed origins for CORS
ALLOWED_ORIGINS="*"

# A2A protocol binding. Possible values: JSONRPC, HTTP+JSON. Only JSONRPC is supported by ICA Agentic apps studio workflows.
A2A_PROTOCOL=JSONRPC

# The base url for the ICA API
ICA_ENDPOINT="https://servicesessentials.ibm.com/agenticapps/api/v1"

# The authentication token. Can be retrieved in the ICA agentic apps studio settings.
ICA_TOKEN="<your-jwt-or-api-token>"

# Required ICA entity IDs
ICA_TEAM_ID="<your-team-id>"
ICA_APP_ID="<your-app-id>"
ICA_USER_ID="<your-user-id>"

# Toggles for automatic agent registration and observability
ICA_REGISTER_AGENT=false
ICA_OBSERVABILITY=false
AGENTSTUDIO_HOOKS=hooks_example

# Phoenix endpoint for observability can be retrieved in the ICA agentic apps studio settings.
# PHOENIX_COLLECTOR_ENDPOINT="https://<phoenix-host>/v1/traces"

# Public URL used for agent registration (required when ICA_REGISTER_AGENT=true)
# PUBLIC_AGENT_URL="https://<your-ngrok-or-public-url>"

# Static bearer token auth. When set, all requests must include "Authorization: Bearer <token>".
# Can be used as a simple alternative or alongside Keycloak authorization.
# A2A_BEARER_TOKEN="<your-secret-token>"

# Authorization with Keycloak. No authorization if these variables are not set or commented out.
# KEYCLOAK_ISSUER_URL="https://<keycloak-host>/realms/<realm>"
# KEYCLOAK_JWKS_URL="https://<keycloak-host>/realms/<realm>/protocol/openid-connect/certs"
# KEYCLOAK_USERINFO_URL="https://<keycloak-host>/realms/<realm>/protocol/openid-connect/userinfo"

